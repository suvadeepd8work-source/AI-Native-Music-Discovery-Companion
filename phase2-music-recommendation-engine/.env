# Spotify API Credentials
# Get your credentials from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Last.fm API Credentials
# Get your API key from: https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key_here

# Jamendo API Credentials
# Get your client ID from: https://developer.jamendo.com/
JAMENDO_CLIENT_ID=your_jamendo_client_id_here

# Review Discovery Engine URL
# This is the URL for the Review Discovery Engine (Phase 3 or external service)
REVIEW_ENGINE_URL=http://localhost:8003

# Database Configuration
# PostgreSQL database URL for persistent storage
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/music_discovery

# Redis Configuration
# Redis server for caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Mock Mode
# Set to 'true' to use mock implementations without real API calls
USE_MOCKS=false
