# Last.fm API Credentials (Free API)
LASTFM_API_KEY=your_lastfm_api_key

# Review Discovery Engine URL
REVIEW_ENGINE_URL=http://localhost:8003

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/music_discovery

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Mock Mode (set to true for testing without real APIs)
USE_MOCKS=false
