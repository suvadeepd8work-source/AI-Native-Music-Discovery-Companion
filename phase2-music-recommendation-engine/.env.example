# Spotify API Credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Last.fm API Credentials
LASTFM_API_KEY=your_lastfm_api_key

# Jamendo API Credentials
JAMENDO_CLIENT_ID=your_jamendo_client_id

# Review Discovery Engine URL
REVIEW_ENGINE_URL=http://localhost:8003

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/music_discovery

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Mock Mode (set to true for testing without real APIs)
USE_MOCKS=false
