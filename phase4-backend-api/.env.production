# Production Environment Variables for Backend

# API Keys
GROQ_API_KEY=
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=

# Review Discovery Engine
REVIEW_ENGINE_URL=https://ai-powered-review-discovery-engine.onrender.com

# Database Configuration (Render PostgreSQL)
DATABASE_URL=

# Redis Configuration (Render Redis)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

# Server Configuration
PORT=8005
HOST=0.0.0.0

# CORS Configuration
CORS_ORIGINS=https://ai-native-music-discovery-frontend.vercel.app,https://ai-native-music-discovery-frontend.vercel.app/*
