# Phase 6: Scheduler Environment Configuration

# Groq API Key for insight generation
GROQ_API_KEY=your_groq_api_key_here

# Mock Mode (set to false for production with real APIs)
USE_MOCKS=false

# Music Review Source APIs
PITCHFORK_API_KEY=your_pitchfork_api_key_here
ROLLING_STONE_API_KEY=your_rolling_stone_api_key_here
NME_API_KEY=your_nme_api_key_here
ALLMUSIC_API_KEY=your_allmusic_api_key_here

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/music_discovery
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=music_discovery
DATABASE_USER=user
DATABASE_PASSWORD=password

# Phase API Endpoints
PHASE1_URL=http://localhost:8001
PHASE2_URL=http://localhost:8002
PHASE3_URL=http://localhost:8003
PHASE4_URL=http://localhost:8005

# Phase API Authentication (if required)
PHASE1_API_KEY=your_phase1_api_key_here
PHASE2_API_KEY=your_phase2_api_key_here
PHASE3_API_KEY=your_phase3_api_key_here
PHASE4_API_KEY=your_phase4_api_key_here

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
FRONTEND_API_KEY=your_frontend_api_key_here

# Frontend API Endpoints
FRONTEND_INSIGHTS_ENDPOINT=/api/insights
FRONTEND_RECOMMENDATIONS_ENDPOINT=/api/recommendations
FRONTEND_HISTORY_ENDPOINT=/api/history
FRONTEND_CACHE_ENDPOINT=/api/cache/clear

# API Timeouts (in seconds)
API_TIMEOUT=30
REVIEW_DOWNLOAD_TIMEOUT=30
FRONTEND_UPDATE_TIMEOUT=30

# Scheduler Configuration
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_DAY_OF_WEEK=mon
SCHEDULER_HOUR=10
SCHEDULER_MINUTE=0

# Logging Configuration
LOG_DIR=./logs/scheduler
LOG_LEVEL=INFO
LOG_FORMAT=json
