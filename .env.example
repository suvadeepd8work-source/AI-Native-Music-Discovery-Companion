# AI Music Discovery Companion - Environment Configuration

# Phase 1: AI Conversation Engine
GROQ_API_KEY=your_groq_api_key_here

# Phase 2: Music Recommendation Engine
LASTFM_API_KEY=your_lastfm_api_key_here
LASTFM_SHARED_SECRET=your_lastfm_shared_secret_here

# Phase 4: Backend API
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/music_discovery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Review Discovery Engine (Optional - defaults to deployed system)
REVIEW_ENGINE_URL=https://ai-powered-review-discovery-engine.onrender.com

# Phase API Endpoints
PHASE1_URL=http://localhost:8001
PHASE2_URL=http://localhost:8002
PHASE3_URL=http://localhost:8003
PHASE4_URL=http://localhost:8005

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
FRONTEND_API_KEY=your_frontend_api_key_here

# Scheduler Configuration
USE_MOCKS=false
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_DAY_OF_WEEK=mon
SCHEDULER_HOUR=10
SCHEDULER_MINUTE=0

# Testing Configuration
USE_MOCKS=false
TESTING=false

# API Configuration
API_BASE_URL=http://localhost:8005
